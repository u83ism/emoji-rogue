{
	"name": "emoji-rogue",
	"version": "0.0.0",
	"description": "A CLI roguelike rendered in emoji, built on a modernized fork of rot.js's map/FOV/pathfinding/scheduler algorithms",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"license": "BSD-3-Clause",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"ink": "^7.1.0",
		"react": "^19.2.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"ink-testing-library": "^4.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
